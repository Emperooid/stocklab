# Paystack PUBLIC (test or live) key — safe to expose client-side, this is
# what Paystack's own checkout is designed to accept from the browser/app.
# Get it from https://dashboard.paystack.com/#/settings/developers
#
# NEVER put your Paystack SECRET key here or anywhere in this app — it must
# only ever live on your backend, which is what actually verifies payments
# and initiates withdrawals.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# StockLab backend gateway. This "secret" ships inside the app bundle and is
# extractable by anyone who inspects it — see src/api/backendClient.ts for
# why, and what to do about it.
EXPO_PUBLIC_BACKEND_BASE_URL=http://your-backend-host
EXPO_PUBLIC_BACKEND_AUTH_USER_ID=your-auth-sp-user-id
EXPO_PUBLIC_BACKEND_AUTH_SECRET_KEY=your-auth-sp-secret-key
