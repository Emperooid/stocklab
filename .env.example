# StockLab backend gateway. This "secret" ships inside the app bundle and is
# extractable by anyone who inspects it — see src/api/backendClient.ts for
# why, and what to do about it.
EXPO_PUBLIC_BACKEND_BASE_URL=http://your-backend-host
# base64-encoded — see the comment in your real .env for why (raw values
# with "$" get mangled by Expo's env loader). Generate with:
#   node -e "console.log(Buffer.from('RAW_VALUE_HERE').toString('base64'))"
EXPO_PUBLIC_BACKEND_AUTH_USER_ID_B64=your-auth-sp-user-id-in-base64
EXPO_PUBLIC_BACKEND_AUTH_SECRET_KEY_B64=your-auth-sp-secret-key-in-base64
